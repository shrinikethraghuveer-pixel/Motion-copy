# Public Supabase project settings (safe for browser use)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Sentry: use the same project DSN in client and server runtime.
NEXT_PUBLIC_SENTRY_DSN=https://public-key@o0.ingest.sentry.io/0
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
# Optional server-only overrides. Keep SENTRY_AUTH_TOKEN out of runtime and client env.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Build-only Sentry source-map upload settings (CI/build environment only)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project

# Server-only application secrets; fill only where needed.
GROQ_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=
MOTION_ADMIN_EMAILS=moderator@example.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
MOTION_BLOCKED_TERMS=
